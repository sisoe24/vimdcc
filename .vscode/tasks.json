{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "RunApp",
            "type": "shell",
            "command": "uv run vimdcc"
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pytest",
                "-xsl",
                "-vvv",
                // "-m quick"
            ],
            "group": "test",
            "hide": true,
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "git",
            "args": [
                "archive",
                "--output=dist/vimdcc.zip",
                "--format=zip",
                "main"
            ],
        }
    ]
}
